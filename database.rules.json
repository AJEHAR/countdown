{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[A-Z0-9]{6}$/)",
        ".write": "$room.matches(/^[A-Z0-9]{6}$/)",
        "state": {
          ".validate": "newData.isString() && newData.val().length < 500000"
        },
        "ctl": {
          "$id": {
            ".validate": "newData.isBoolean()"
          }
        },
        "disp": {
          "$id": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        },
        "updated": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        }
      },
      ".indexOn": [
        "updated"
      ]
    },
    "shares": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{8}$/) && !data.child('revoked').exists() && (data.child('exp').val() === 0 || data.child('exp').val() > now)",
        ".write": "$code.matches(/^[A-Z0-9]{8}$/) && !data.exists()",
        ".validate": "newData.hasChildren(['data', 'exp', 'created'])",
        "data": {
          ".validate": "newData.isString() && newData.val().length < 500000"
        },
        "exp": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || (newData.val() > now && newData.val() <= now + 604800000 + 600000))"
        },
        "created": {
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "revoked": {
          ".write": "data.parent().exists() && !data.exists()",
          ".validate": "newData.isString() && root.child('shareOwners').child($code).child(newData.val()).exists()"
        },
        "$other": {
          ".validate": false
        }
      },
      ".indexOn": [
        "exp",
        "created"
      ]
    },
    "shareOwners": {
      "$code": {
        ".write": "$code.matches(/^[A-Z0-9]{8}$/) && !data.exists()",
        "$secret": {
          ".validate": "newData.val() === true && $secret.matches(/^[a-z0-9]{16,64}$/)"
        }
      }
    }
  }
}